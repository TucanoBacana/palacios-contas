# Copie este arquivo para ".env" e preencha com a connection string do Supabase
# (Project Settings > Database > Connection string > URI, modo "Session pooler"
# funciona bem para o plano free).
DATABASE_URL=postgresql://postgres:SENHA@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --- Bot do WhatsApp (configure estas no Render; veja o README) ---
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_VERIFY_TOKEN=uma-frase-qualquer-que-voce-escolher
# WHATSAPP_APP_SECRET=
# WHATSAPP_NUMEROS=5511999990000:Yan,5521988880000:Maria

# --- Bot do Telegram (configure no Render; veja o README) ---
# TELEGRAM_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=uma-frase-secreta-sem-espacos
# TELEGRAM_USUARIOS=123456789:Yan,987654321:Maria
# TELEGRAM_AVISOS=123456789          (quem recebe estoque baixo, resumo e backup)
# ESTOQUE_MINIMO=5
# RESUMO_HORA=20
# COBRANCA_PIX=sua-chave-pix         (aparece na mensagem de cobranca)
